# Local edge mode works without cloud credentials.
# Vercel: use public after the owner enables the selected device in Supabase.
# cloud retains the optional authenticated caregiver deployment.
VITE_ACCESS_MODE=local
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=
# Never put a service-role key or device secret in a VITE_ variable.
